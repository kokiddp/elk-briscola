# Copy to .env (`cp .env.example .env`) and fill in the secrets before
# `docker compose up`. Every key marked REQUIRED must be set or the API
# will refuse to start.

# === REQUIRED ===

# Postgres superuser password for the briscola database. Used by both
# the `postgres` service (POSTGRES_PASSWORD) and the api's connection
# string. Pick a long random string; rotated by `docker compose down -v`
# then re-up (destroys data) or via `ALTER USER` (preserves data).
POSTGRES_PASSWORD=replace-me-with-a-long-random-string

# JWT signing key for access-token HMAC-SHA256. Base64-encoded, at
# least 32 bytes after decode. The API fails fast on startup if this
# is missing or short.
#
# Generate one with:
#   openssl rand -base64 32
JWT_SIGNING_KEY=replace-me-with-base64-32B-min

# === OPTIONAL ===

# Image tag for the api + frontend services. Used both for `docker
# compose pull` of prebuilt images and for tagging local builds.
# Defaults to `latest`.
# IMAGE_TAG=v0.1.0

# Owner part of the ghcr.io/<namespace>/<image>:<tag> coordinate. The
# release workflow pushes to this namespace. Defaults to `elk-briscola`.
# GHCR_NAMESPACE=koki

# JWT issuer + audience. Defaults: `briscola`. Set if you're terminating
# tokens behind a different identity provider.
# JWT_ISSUER=briscola
# JWT_AUDIENCE=briscola

# CORS origin the browser will load the SPA from. Defaults to
# `http://localhost:8080` (the FRONTEND_HOST_PORT below). Set this to
# the public origin in production (e.g. `https://briscola.example.com`).
# ALLOWED_ORIGIN=https://briscola.example.com

# Host port that maps to the frontend nginx (which then reverse-proxies
# /api/* and /hubs/* to the api over the compose network). Defaults to
# 8080.
# FRONTEND_HOST_PORT=8080

# OpenTelemetry OTLP endpoint. When set, the api swaps the dev console
# exporter for OTLP and ships metrics + (future) traces to the collector
# you've pointed this at.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otelcol:4317

# ASP.NET environment. Defaults to `Production` (prod-grade rate limits,
# CompactJsonFormatter logs, HSTS on). `Development` adds the dev-only
# Swagger / Scalar surfaces and a rolling file logger; `Stress` relaxes
# auth rate limits for the load harness.
#
# NEVER persist `ASPNETCORE_ENVIRONMENT=Stress` in this .env (or .env
# itself in deployment) — appsettings.Stress.json raises auth limits to
# 1,000,000 req/min, effectively disabling brute-force protection. Pass
# Stress inline only for the duration of a load-test run, e.g.
#   ASPNETCORE_ENVIRONMENT=Stress docker compose up
# ASPNETCORE_ENVIRONMENT=Production
